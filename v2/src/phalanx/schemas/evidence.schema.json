{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ET evidence clauses (ET linkage)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "threat",
    "status",
    "source_text",
    "clauses"
  ],
  "properties": {
    "threat": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "source_text": {
      "type": "string"
    },
    "clauses": {
      "type": "object",
      "propertyNames": {
        "pattern": "^ET-EV-[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clause",
          "techniques",
          "rationale"
        ],
        "properties": {
          "clause": {
            "type": "string",
            "minLength": 1
          },
          "techniques": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}
