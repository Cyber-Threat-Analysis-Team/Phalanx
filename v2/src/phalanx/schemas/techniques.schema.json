{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technique profiles (rule table)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "action_window",
    "tactic_defaults",
    "overrides",
    "attacker_seeds",
    "deprecation_successors"
  ],
  "properties": {
    "_about": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "authored_by": {
      "type": "string"
    },
    "action_window": {
      "type": "string"
    },
    "tactic_defaults": {
      "type": "object",
      "additionalProperties": {
        "allOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "prep",
                  "entry",
                  "ground",
                  "onboard"
                ]
              },
              "access": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "authority": {
                "type": "string"
              },
              "target": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "effect": {
                "oneOf": [
                  {
                    "const": "enabling"
                  },
                  {
                    "type": "array",
                    "items": {
                      "enum": [
                        "C",
                        "I",
                        "A"
                      ]
                    },
                    "uniqueItems": true,
                    "minItems": 1
                  }
                ]
              },
              "lifecycle": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "uniqueItems": true
              },
              "traverses": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "requires_fact": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "boolean"
                  ]
                }
              }
            }
          },
          {
            "required": [
              "kind"
            ]
          }
        ]
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "prep",
              "entry",
              "ground",
              "onboard"
            ]
          },
          "access": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "authority": {
            "type": "string"
          },
          "target": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "effect": {
            "oneOf": [
              {
                "const": "enabling"
              },
              {
                "type": "array",
                "items": {
                  "enum": [
                    "C",
                    "I",
                    "A"
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              }
            ]
          },
          "lifecycle": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "uniqueItems": true
          },
          "traverses": {
            "type": [
              "string",
              "null"
            ]
          },
          "requires_fact": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "boolean"
              ]
            }
          }
        }
      }
    },
    "attacker_seeds": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "deprecation_successors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sv_layer_targets"
      ],
      "properties": {
        "_about": {
          "type": "string"
        },
        "sv_layer_targets": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
